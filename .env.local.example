# Copy this file to .env.local and fill in real values before deploying.

# The canonical URL this site is deployed at. Used for metadata, sitemap.xml,
# robots.txt, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://pedaldown.tech

# TODO: paste your Formspree (or Formspree-compatible) form endpoint here.
# Sign up at https://formspree.io, create a form, and use the endpoint it
# gives you (looks like https://formspree.io/f/xxxxxxx). Without this set,
# the contact form shows visitors a direct-email fallback instead of
# silently discarding submissions.
NEXT_PUBLIC_FORM_ENDPOINT=
