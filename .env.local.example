# Copy this file to .env.local and fill in real values before deploying.

# The canonical URL this site is deployed at. Used for metadata, sitemap.xml,
# robots.txt, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://pedaldown.tech

# Optional. The contact form falls back to FormSubmit using the address in
# src/lib/site.ts, which needs no account but must be activated once (see
# README.md). Set this to override, e.g. a FormSubmit hash alias, which keeps
# the raw address out of the page source, or a Formspree endpoint.
NEXT_PUBLIC_FORM_ENDPOINT=
